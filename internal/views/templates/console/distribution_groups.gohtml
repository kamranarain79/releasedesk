{{ define "content" }}
    {{- /*gotype: github.com/brewbits-co/releasedesk/internal/controllers/app.groupPage*/ -}}
    <h2 class="text-2xl font-bold text-gray-900">Distribution groups</h2>
    <p class="mt-2 text-sm text-gray-600">Optional extra lists. App membership still controls the console. Restrict portal is stored for a later gate and defaults off so factory downloads keep working.</p>
    <ul class="mt-4 text-sm text-gray-700">{{range .Groups}}<li>{{.Name}}{{if .RestrictPortal}} (portal restricted){{end}}</li>{{else}}<li>No groups.</li>{{end}}</ul>
    <form class="mt-4 flex gap-2" method="POST" action="/internal/apps/{{.AppSlug}}/distribution-groups">
        <input name="name" required placeholder="Factory" class="rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
        <label class="text-sm text-gray-700"><input type="checkbox" name="restrict" value="1"> Restrict portal</label>
        <button class="rounded-md bg-violet-800 px-3 py-2 text-sm font-semibold text-white" type="submit">Add</button>
    </form>
{{ end }}
