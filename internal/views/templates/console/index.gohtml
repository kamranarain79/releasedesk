<!doctype html>
<html class="h-full bg-gray-100" lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Language" content="en-US">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="icon" href="/branding/favicon">
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
  <link rel="stylesheet" href="/assets/tailwind.css">
  <link href="/assets/css/fontawesome.min.css" rel="stylesheet" />
  <link href="/assets/css/brands.min.css" rel="stylesheet" />
  <link href="/assets/css/solid.min.css" rel="stylesheet" />
  <script type="module" src="/assets/bundle.js"></script>
  <title>ReleaseDesk - Console</title>
</head>
<body class="h-full">
{{ define "avatar" }}
  <span class="relative inline-block h-8 w-8 overflow-hidden rounded-full bg-gray-100">
    <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
      <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z"/>
    </svg>
    <img class="absolute inset-0 h-full w-full object-cover" src="/branding/avatars/{{.UserID}}" alt="" onerror="this.remove()">
  </span>
{{ end }}
{{ define "person" }}
  <span class="inline-flex items-center gap-2">
    <span class="relative inline-block h-6 w-6 shrink-0 overflow-hidden rounded-full bg-gray-100">
      <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
        <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z"/>
      </svg>
      {{ if .UserID }}<img class="absolute inset-0 h-full w-full object-cover" src="/branding/avatars/{{.UserID}}" alt="" onerror="this.remove()">{{ end }}
    </span>
    <span class="text-sm text-gray-900" translate="no">{{.Name}}</span>
  </span>
{{ end }}
{{ define "audit-log" }}
  <h4 class="text-base font-semibold text-gray-900">Audit</h4>
  <ul class="mt-3 divide-y divide-gray-200 rounded-md border border-gray-200 bg-white">
    {{ range . }}
      <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm">
        <span class="inline-flex flex-wrap items-center gap-2">
          {{ if .Name }}{{ template "person" . }}{{ else }}<span translate="no">{{.Actor}}</span>{{ end }}
          <span class="text-gray-700">{{.Summary}}</span>
        </span>
        <span class="text-gray-500">{{.CreatedAtFormatted}}</span>
      </li>
    {{ else }}
      <li class="px-4 py-3 text-sm text-gray-500">No audit entries yet.</li>
    {{ end }}
  </ul>
{{ end }}
{{ template "body" . }}
</body>
</html>