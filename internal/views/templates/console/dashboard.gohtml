{{ define "content" }}
    {{- /*gotype: github.com/brewbits-co/releasedesk/internal/controllers/app.DashboardData*/ -}}
    {{ if .SetupGuideCompleted}}
        <div class="grid justify-items-end">
            <app-platform-drawer slug="{{.CurrentAppData.AppSlug}}" name="{{.CurrentAppData.AppName}}"></app-platform-drawer>
        </div>
        <div class="pb-5">
            <h3 class="text-xl font-semibold tracking-tight text-gray-900">Latest Releases</h3>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow">
            {{ if .LatestReleases }}
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-gray-700 sm:pl-6">Version</th>
                        <th scope="col" class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-gray-700">Status</th>
                        <th scope="col" class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-gray-700">Created by</th>
                        <th scope="col" class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-gray-700">Last edited</th>
                        <th scope="col" class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-gray-700">Updated</th>
                        <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">View</span></th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                    {{- range .LatestReleases }}
                        <tr>
                            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6" translate="no">{{.Version}}</td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{.Status}}</td>
                            <td class="whitespace-nowrap px-3 py-4">{{ template "person" .Creator }}</td>
                            <td class="whitespace-nowrap px-3 py-4">
                                {{ if .HasEditor }}{{ template "person" .Editor }}{{ else }}<span class="text-sm text-gray-400">—</span>{{ end }}
                            </td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">{{.Auditable.UpdatedAtFormatted}}</td>
                            <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                <a href="/dashboard/{{$.CurrentAppData.AppSlug}}/releases/{{.Version}}" class="text-violet-900 hover:text-violet-800">View</a>
                            </td>
                        </tr>
                    {{- end }}
                    </tbody>
                </table>
            {{ else }}
                <p class="px-4 py-8 text-center text-sm text-gray-600">
                    No releases yet.
                    <a href="/dashboard/{{.CurrentAppData.AppSlug}}/releases" class="font-medium text-violet-900 hover:text-violet-800">Create one</a>
                </p>
            {{ end }}
        </div>

        <div class="pb-5 pt-8">
            <h3 class="text-xl font-semibold tracking-tight text-gray-900">Latest Builds</h3>
        </div>
        <div class="overflow-hidden rounded-lg bg-white shadow">
            {{ if .LatestBuilds }}
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-xs font-medium uppercase tracking-wide text-gray-700 sm:pl-6">Platform</th>
                        <th scope="col" class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-gray-700">Number</th>
                        <th scope="col" class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-gray-700">Version</th>
                        <th scope="col" class="px-3 py-3.5 text-left text-xs font-medium uppercase tracking-wide text-gray-700">Uploaded by</th>
                        <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6"><span class="sr-only">View</span></th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                    {{- range .LatestBuilds }}
                        <tr>
                            <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6" translate="no">{{.OS}}</td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500" translate="no">{{.Number}}</td>
                            <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500" translate="no">{{.Version}}</td>
                            <td class="whitespace-nowrap px-3 py-4">{{ template "person" .Uploader }}</td>
                            <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                <a href="/dashboard/{{$.CurrentAppData.AppSlug}}/platforms/{{.OS}}/builds/{{.Number}}" class="text-violet-900 hover:text-violet-800">View</a>
                            </td>
                        </tr>
                    {{- end }}
                    </tbody>
                </table>
            {{ else }}
                <p class="px-4 py-8 text-center text-sm text-gray-600">
                    No builds yet. Upload one from a platform in the sidebar.
                </p>
            {{ end }}
        </div>
    {{else}}
        <div class="pb-5">
            <h3 class="text-xl font-semibold tracking-tight text-gray-900">Congrats on the new application!</h3>
            <p class="mt-2 max-w-4xl text-sm text-gray-500">
                Complete these simple steps to get your software distribution up and running.</p>
        </div>
        <div class="rounded-lg bg-white shadow">
            <app-setup-guide slug="{{.CurrentAppData.AppSlug}}"></app-setup-guide>
        </div>
    {{end}}
{{ end }}
