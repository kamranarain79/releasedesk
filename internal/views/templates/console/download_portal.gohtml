{{ define "content" }}
    <div class="space-y-8">
        <div>
            <p class="text-sm text-gray-600">
                The public download portal is where testers and customers pick up builds. In this version it lists public apps.
                Branded pages, tester sign-in, and distribution-group gating will land in a later version.
            </p>
            <div class="mt-4">
                <a href="{{.PortalURL}}" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center rounded-md bg-violet-900 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-800">
                    Open public portal
                </a>
                <p class="mt-2 text-xs text-gray-500" translate="no">{{.PortalURL}}</p>
            </div>
        </div>

        <div>
            <h2 class="text-base font-semibold text-gray-900">Public applications</h2>
            <p class="mt-1 text-sm text-gray-500">Private apps stay in the console until you publish them.</p>
            {{ if .PublicApps }}
                <ul role="list" class="mt-4 divide-y divide-gray-100 overflow-hidden rounded-lg border border-gray-200">
                    {{- range .PublicApps }}
                        <li class="flex items-center justify-between gap-x-6 px-4 py-4">
                            <div>
                                <p class="text-sm font-medium text-gray-900" translate="no">{{.Name}}</p>
                                <p class="text-xs text-gray-500" translate="no">{{.Slug}}</p>
                            </div>
                            <a href="/dashboard/{{.Slug}}" class="text-sm font-medium text-violet-900 hover:text-violet-800">Manage</a>
                        </li>
                    {{- end }}
                </ul>
            {{ else }}
                <div class="mt-4 rounded-lg border border-dashed border-gray-300 bg-gray-50 px-6 py-10 text-center">
                    <p class="text-sm text-gray-600">No public apps yet. Create an application on the homepage and leave it public.</p>
                </div>
            {{ end }}
        </div>
    </div>
{{ end }}
