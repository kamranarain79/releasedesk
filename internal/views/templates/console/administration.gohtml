{{ define "content" }}
    <div class="lg:grid lg:grid-cols-[13rem_1fr] lg:gap-8">
        <nav class="mb-6 flex gap-2 overflow-x-auto lg:mb-0 lg:flex-col" aria-label="Administration">
            <a href="/administration" class="whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium {{if eq .Section "general"}}bg-violet-100 text-violet-900{{else}}text-gray-700 hover:bg-gray-100{{end}}">General</a>
            {{ if .IsAdmin }}
                <a href="/administration/branding" class="whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium {{if eq .Section "branding"}}bg-violet-100 text-violet-900{{else}}text-gray-700 hover:bg-gray-100{{end}}">Branding</a>
                <a href="/administration/email" class="whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium {{if eq .Section "email"}}bg-violet-100 text-violet-900{{else}}text-gray-700 hover:bg-gray-100{{end}}">Email</a>
                <a href="/administration/token" class="whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium {{if eq .Section "token"}}bg-violet-100 text-violet-900{{else}}text-gray-700 hover:bg-gray-100{{end}}">API token</a>
            {{ end }}
        </nav>

        <div class="min-w-0">
            {{ if eq .Section "general" }}
                <dl class="grid grid-cols-1 gap-4">
                    <div class="rounded-lg border border-gray-200 bg-white p-4">
                        <dt class="text-sm font-medium text-gray-900">Database</dt>
                        <dd class="mt-1 text-sm text-gray-600">{{.Database}}. {{.DatabaseNote}}</dd>
                    </div>
                    <div class="rounded-lg border border-gray-200 bg-white p-4">
                        <dt class="text-sm font-medium text-gray-900">Artifact files</dt>
                        <dd class="mt-1 text-sm text-gray-600"><span translate="no">{{.DataDir}}</span></dd>
                    </div>
                    <div class="rounded-lg border border-gray-200 bg-white p-4">
                        <dt class="text-sm font-medium text-gray-900">API docs</dt>
                        <dd class="mt-1 text-sm text-gray-600"><a class="text-violet-800" href="/api/docs">Open API docs</a></dd>
                    </div>
                </dl>
            {{ else if and .IsAdmin (eq .Section "branding") }}
                <section class="max-w-xl rounded-lg border border-gray-200 bg-white p-6">
                    <h2 class="text-base font-semibold text-gray-900">Company logo and favicon</h2>
                    <p class="mt-1 text-sm text-gray-600">PNG, JPEG, GIF, WebP, or ICO. Up to 2MB. The logo is shown in the console, the login page, and the download portal.</p>
                    <div class="mt-4 flex items-center gap-6">
                        <img class="h-12 w-12 rounded object-contain ring-1 ring-gray-200" src="/branding/logo" alt="Current logo">
                        <img class="h-8 w-8 rounded object-contain ring-1 ring-gray-200" src="/branding/favicon" alt="Current favicon">
                    </div>
                    <form class="mt-4 space-y-3" method="POST" action="/internal/administration/branding" enctype="multipart/form-data">
                        <label class="block text-sm font-medium text-gray-900">Logo
                            <input class="mt-1 block w-full text-sm" name="logo" type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/x-icon">
                        </label>
                        {{ if .HasLogo }}<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="clearlogo" value="1"> Remove custom logo</label>{{ end }}
                        <label class="block text-sm font-medium text-gray-900">Favicon
                            <input class="mt-1 block w-full text-sm" name="favicon" type="file" accept="image/png,image/jpeg,image/gif,image/webp,image/x-icon,.ico">
                        </label>
                        {{ if .HasFavicon }}<label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="clearfavicon" value="1"> Remove custom favicon</label>{{ end }}
                        <button class="rounded-md bg-violet-800 px-3 py-2 text-sm font-semibold text-white" type="submit">Save branding</button>
                    </form>
                </section>
            {{ else if and .IsAdmin (eq .Section "email") }}
                <section class="max-w-xl rounded-lg border border-gray-200 bg-white p-6">
                    <h2 class="text-base font-semibold text-gray-900">Outgoing email</h2>
                    <p class="mt-1 text-sm text-gray-600">Used for announcements. Leave the password blank to keep the saved one.</p>
                    <form class="mt-4 space-y-3" method="POST" action="/internal/administration/smtp">
                        <label class="block text-sm font-medium text-gray-900">Host
                            <input name="host" value="{{.SMTPHost}}" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
                        </label>
                        <label class="block text-sm font-medium text-gray-900">Port
                            <input name="port" value="{{if .SMTPPort}}{{.SMTPPort}}{{else}}587{{end}}" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
                        </label>
                        <label class="block text-sm font-medium text-gray-900">Username
                            <input name="user" value="{{.SMTPUser}}" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
                        </label>
                        <label class="block text-sm font-medium text-gray-900">Password
                            <input name="password" type="password" placeholder="{{if .SMTPPasswordSet}}Password saved{{else}}Password{{end}}" autocomplete="new-password" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
                        </label>
                        <label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="clearPassword" value="1"> Clear saved password</label>
                        <label class="block text-sm font-medium text-gray-900">From
                            <input name="from" value="{{.SMTPFrom}}" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
                        </label>
                        <label class="block text-sm font-medium text-gray-900">Send a test to
                            <input name="testTo" type="email" placeholder="Optional" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
                        </label>
                        <button class="rounded-md bg-violet-800 px-3 py-2 text-sm font-semibold text-white" type="submit">Save</button>
                    </form>
                </section>
            {{ else if and .IsAdmin (eq .Section "token") }}
                <section class="max-w-xl space-y-3 rounded-lg border border-gray-200 bg-white p-6">
                    <h2 class="text-base font-semibold text-gray-900">Instance API token</h2>
                    <p class="text-sm text-gray-600">Generated on first start and stored as a hash. It can read every app. Per-app tokens in each application's Settings are the ones to give GitLab.</p>
                    <p class="text-sm text-gray-700">Prefix <span translate="no">{{.TokenPrefix}}</span></p>
                    {{ if .TokenPending }}
                        <p class="rounded-md bg-amber-50 p-3 text-sm text-amber-900">Copy this token now. It is hidden after you dismiss it.<br><span translate="no">{{.TokenPending}}</span></p>
                        <form method="POST" action="/internal/administration/token/dismiss">
                            <button class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300" type="submit">Dismiss</button>
                        </form>
                    {{ end }}
                    {{ if .EnvToken }}
                        <p class="text-sm text-gray-600">RELEASEDESK_API_TOKEN from the environment is also accepted.</p>
                    {{ end }}
                    <form method="POST" action="/internal/administration/token">
                        <button class="rounded-md bg-violet-800 px-3 py-2 text-sm font-semibold text-white" type="submit">Generate a new token</button>
                    </form>
                </section>
            {{ else }}
                <p class="text-sm text-gray-600">Only the instance admin can change branding, email, and the API token.</p>
            {{ end }}
        </div>
    </div>
{{ end }}
