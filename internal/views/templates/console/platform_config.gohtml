{{ define "content" }}
    {{- /*gotype: github.com/brewbits-co/releasedesk/internal/controllers/app.configPage*/ -}}
    <h2 class="text-2xl font-bold text-gray-900">{{.OS}} configuration</h2>
    <p class="mt-2 text-sm text-gray-600">Flash notes are returned as flashHint on the factory file listing. Firmware bytes are not rewritten.</p>
    <form class="mt-6 max-w-xl" method="POST" action="/internal/apps/{{.AppSlug}}/platforms/{{.OS}}/configs">
        <label class="block text-sm font-medium text-gray-900">Flash notes
            <textarea name="flash_notes" rows="6" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">{{range .Items}}{{if eq .Key "flash_notes"}}{{.Value}}{{end}}{{end}}</textarea>
        </label>
        <button class="mt-3 rounded-md bg-violet-800 px-3 py-2 text-sm font-semibold text-white" type="submit">Save</button>
    </form>
{{ end }}
