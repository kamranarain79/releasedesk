{{ define "content" }}
    <div class="grid gap-6 lg:grid-cols-2">
        <section class="rounded-lg border border-gray-200 bg-white p-6">
            <h2 class="text-base font-semibold text-gray-900">Photo</h2>
            <div class="mt-4 flex items-center gap-4">
                <span class="relative inline-block h-16 w-16 overflow-hidden rounded-full bg-gray-100">
                    <svg class="h-full w-full text-gray-300" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M24 20.993V24H0v-2.996A14.977 14.977 0 0112.004 15c4.904 0 9.26 2.354 11.996 5.993zM16.002 8.999a4 4 0 11-8 0 4 4 0 018 0z"/>
                    </svg>
                    <img class="absolute inset-0 h-full w-full object-cover" src="/branding/avatars/{{.User.ID}}" alt="" onerror="this.remove()">
                </span>
                <form method="POST" action="/internal/account/avatar" enctype="multipart/form-data" class="space-y-2">
                    <input name="avatar" type="file" accept="image/png,image/jpeg,image/gif,image/webp">
                    <div class="flex gap-2">
                        <button class="rounded-md bg-violet-800 px-3 py-2 text-sm font-semibold text-white" type="submit">Upload</button>
                        <button class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300" type="submit" name="clear" value="1">Remove</button>
                    </div>
                </form>
            </div>
        </section>

        <section class="rounded-lg border border-gray-200 bg-white p-6">
            <h2 class="text-base font-semibold text-gray-900">Profile</h2>
            <p class="mt-1 text-sm text-gray-500">Username <span translate="no">{{.User.Username}}</span> · {{.User.Role.String}}</p>
            <form class="mt-4 space-y-3" method="POST" action="/internal/account/profile">
                <label class="block text-sm font-medium text-gray-900">First name
                    <input name="firstName" required value="{{if .User.FirstName.Valid}}{{.User.FirstName.String}}{{end}}" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
                </label>
                <label class="block text-sm font-medium text-gray-900">Last name
                    <input name="lastName" required value="{{if .User.LastName.Valid}}{{.User.LastName.String}}{{end}}" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
                </label>
                <label class="block text-sm font-medium text-gray-900">Email
                    <input name="email" type="email" required value="{{if .User.Email.Valid}}{{.User.Email.String}}{{end}}" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
                </label>
                <button class="rounded-md bg-violet-800 px-3 py-2 text-sm font-semibold text-white" type="submit">Save profile</button>
            </form>
        </section>

        <section class="rounded-lg border border-gray-200 bg-white p-6 lg:col-span-2">
            {{ if .User.MustChangePassword }}
                <p class="mb-4 rounded-md bg-amber-50 p-3 text-sm text-amber-900">Change the seeded password before using this console in production. The current password is not required for this first change.</p>
            {{ end }}
            <h2 class="text-base font-semibold text-gray-900">Password</h2>
            <form class="mt-4 grid max-w-md gap-3" method="POST" action="/internal/account/password">
                <label class="block text-sm font-medium text-gray-900">Current password
                    <input name="current" type="password" autocomplete="current-password" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
                </label>
                <label class="block text-sm font-medium text-gray-900">New password
                    <input name="next" type="password" required autocomplete="new-password" class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
                    <span class="mt-1 block text-xs font-normal text-gray-500">At least 8 characters, with an uppercase letter, a lowercase letter, and a digit.</span>
                </label>
                <button class="w-fit rounded-md bg-violet-800 px-3 py-2 text-sm font-semibold text-white" type="submit">Update password</button>
            </form>
        </section>
    </div>
{{ end }}
