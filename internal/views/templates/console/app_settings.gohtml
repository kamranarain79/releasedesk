{{ define "content" }}
    {{- /*gotype: github.com/brewbits-co/releasedesk/internal/controllers/app.settingsPage*/ -}}
    <h2 class="text-2xl font-bold text-gray-900">Settings</h2>
    <p class="mt-2 text-sm text-gray-600">App admins manage visibility, the Teams webhook, members, and CI tokens. Members are like a Teams channel: admin or user.</p>
    {{ if .Error }}
        <p class="mt-4 rounded-md bg-red-50 p-3 text-sm text-red-800">{{.Error}}</p>
    {{ end }}
    {{ if .NewToken }}
        <p class="mt-4 rounded-md bg-amber-50 p-3 text-sm text-amber-900">Copy this CI token now. It will not be shown again: <span translate="no">{{.NewToken}}</span></p>
    {{ end }}
    <form class="mt-6 space-y-4 max-w-xl" method="POST" action="/internal/apps/{{.AppSlug}}/settings">
        <label class="block text-sm font-medium text-gray-900">Description
            <textarea name="description" rows="3" class="mt-1 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300">{{if .App.Description.Valid}}{{.App.Description.String}}{{end}}</textarea>
        </label>
        <label class="flex items-center gap-2 text-sm text-gray-900">
            <input type="checkbox" name="private" value="1" {{if .App.Private}}checked{{end}}> Private (hidden from the public portal)
        </label>
        <label class="block text-sm font-medium text-gray-900">Microsoft Teams incoming webhook
            <input type="url" name="teamsWebhookUrl" placeholder="https://outlook.office.com/webhook/..." class="mt-1 block w-full rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
        </label>
        {{ if .App.TeamsWebhookURL }}<p class="text-xs text-gray-500">A webhook is already saved. Leave the field blank to keep it, or tick clear to remove it.</p>{{ end }}
        <label class="flex items-center gap-2 text-sm text-gray-700"><input type="checkbox" name="clearWebhook" value="1"> Clear saved webhook</label>
        <button class="rounded-md bg-violet-800 px-3 py-2 text-sm font-semibold text-white" type="submit">Save</button>
    </form>
    <form class="mt-3" method="POST" action="/internal/apps/{{.AppSlug}}/webhooks/test">
        <button class="text-sm font-medium text-violet-800" type="submit">Send test to Teams</button>
    </form>

    <h3 class="mt-10 text-lg font-semibold text-gray-900">Members</h3>
    <ul class="mt-3 divide-y divide-gray-200 rounded-md border border-gray-200 bg-white">
        {{range .Members}}
            <li class="flex items-center justify-between gap-3 px-4 py-3 text-sm">
                <span translate="no"><span class="font-medium text-gray-900">{{.Username}}</span> — {{.Role}}</span>
                {{ if $.CanAdmin }}
                    <form method="POST" action="/internal/apps/{{$.AppSlug}}/members/{{.UserID}}/remove">
                        <button class="rounded-md bg-white px-2 py-1 text-sm font-semibold text-red-700 ring-1 ring-inset ring-red-200" type="submit">Remove</button>
                    </form>
                {{ end }}
            </li>
        {{else}}
            <li class="px-4 py-3 text-sm text-gray-500">No members yet.</li>
        {{end}}
    </ul>
    {{ if .CanAdmin }}
        <form class="mt-3 flex flex-wrap items-end gap-2" method="POST" action="/internal/apps/{{.AppSlug}}/members">
            <label class="text-sm text-gray-700">Person
                <select name="userId" class="mt-1 block rounded-md border-gray-300 text-sm">
                    {{range .Users}}<option value="{{.ID}}">{{.Username}}</option>{{end}}
                </select>
            </label>
            <label class="text-sm text-gray-700">Role
                <select name="role" class="mt-1 block rounded-md border-gray-300 text-sm">
                    <option value="user">user</option>
                    <option value="admin">admin</option>
                </select>
            </label>
            <button class="rounded-md bg-violet-800 px-3 py-2 text-sm font-semibold text-white" type="submit">Add</button>
        </form>
    {{ end }}

    <h3 class="mt-10 text-lg font-semibold text-gray-900">CI tokens</h3>
    <p class="mt-1 text-sm text-gray-600">Mint a separate token for each job. Read can download. Read and write can create releases and upload builds. Revoke stops that token immediately.</p>
    <ul class="mt-3 divide-y divide-gray-200 rounded-md border border-gray-200 bg-white">
        {{range .Tokens}}
            <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm">
                <span translate="no">
                    <span class="font-medium text-gray-900">{{.Name}}</span>
                    <span class="text-gray-500">{{.Prefix}}…</span>
                    {{ if eq .Scope "read" }}Read{{ else }}Read and write{{ end }}
                    {{ if .Revoked }}<span class="text-red-700">Revoked</span>{{ end }}
                </span>
                {{ if and $.CanAdmin (not .Revoked) }}
                    <form method="POST" action="/internal/apps/{{$.AppSlug}}/tokens/{{.ID}}/revoke">
                        <button class="rounded-md bg-white px-2 py-1 text-sm font-semibold text-red-700 ring-1 ring-inset ring-red-200" type="submit">Revoke</button>
                    </form>
                {{ end }}
            </li>
        {{else}}
            <li class="px-4 py-3 text-sm text-gray-500">No tokens.</li>
        {{end}}
    </ul>
    {{ if .CanAdmin }}
        <form class="mt-3 flex flex-wrap items-end gap-2" method="POST" action="/internal/apps/{{.AppSlug}}/tokens">
            <label class="text-sm text-gray-700">Name
                <input name="name" required placeholder="gitlab-firmware" class="mt-1 block rounded-md border-0 py-1.5 shadow-sm ring-1 ring-inset ring-gray-300">
            </label>
            <label class="text-sm text-gray-700">Permission
                <select name="scope" class="mt-1 block rounded-md border-gray-300 text-sm">
                    <option value="write">Read and write</option>
                    <option value="read">Read</option>
                </select>
            </label>
            <button class="rounded-md bg-violet-800 px-3 py-2 text-sm font-semibold text-white" type="submit">Mint token</button>
        </form>

        <h3 class="mt-10 text-lg font-semibold text-red-700">Delete application</h3>
        <p class="mt-1 text-sm text-gray-600">Only an admin can delete this application. Releases, builds, members, and tokens are removed with it.</p>
        <form class="mt-3" method="POST" action="/internal/apps/{{.AppSlug}}/delete" onsubmit="return confirm('Delete {{.App.Name}} and everything in it?')">
            <button class="rounded-md bg-white px-3 py-2 text-sm font-semibold text-red-700 ring-1 ring-inset ring-red-200" type="submit">Delete application</button>
        </form>
    {{ end }}
{{ end }}
