{{ define "body" }}
<div class="min-h-full bg-gray-100">
  <header class="bg-violet-900">
    <div class="mx-auto flex max-w-5xl items-center gap-3 px-4 py-6 sm:px-6 lg:px-8">
      <img class="h-8 w-8 rounded object-contain" src="/branding/logo" alt="ReleaseDesk">
      <h1 class="text-xl font-semibold text-white">Download Portal</h1>
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <p class="text-sm text-gray-600">
      Public apps on this instance. Open an app to download its files.
    </p>

    {{ if .PublicApps }}
      <ul role="list" class="mt-8 grid gap-4 sm:grid-cols-2">
        {{- range .PublicApps }}
          <li class="rounded-lg bg-white p-6 shadow">
            <h2 class="text-lg font-semibold text-gray-900" translate="no">{{.Name}}</h2>
            {{ if .Description }}
              <p class="mt-2 text-sm text-gray-600">{{.Description}}</p>
            {{ end }}
            <p class="mt-3 flex flex-wrap gap-1 text-xs">
              {{ if .HasAndroid }}<span class="rounded-full bg-green-50 px-2 py-1 font-medium text-green-700 ring-1 ring-inset ring-green-200">Android</span>{{ end }}
              {{ if .HasIOS }}<span class="rounded-full bg-gray-50 px-2 py-1 font-medium text-gray-800 ring-1 ring-inset ring-gray-200">iOS</span>{{ end }}
              {{ if .HasWindows }}<span class="rounded-full bg-sky-50 px-2 py-1 font-medium text-sky-700 ring-1 ring-inset ring-sky-200">Windows</span>{{ end }}
              {{ if .HasLinux }}<span class="rounded-full bg-amber-50 px-2 py-1 font-medium text-amber-700 ring-1 ring-inset ring-amber-200">Linux</span>{{ end }}
              {{ if .HasMacOS }}<span class="rounded-full bg-blue-50 px-2 py-1 font-medium text-blue-700 ring-1 ring-inset ring-blue-200">macOS</span>{{ end }}
              {{ if .HasESP32 }}<span class="rounded-full bg-orange-50 px-2 py-1 font-medium text-orange-700 ring-1 ring-inset ring-orange-200">ESP32</span>{{ end }}
              {{ if .HasSTM32 }}<span class="rounded-full bg-indigo-50 px-2 py-1 font-medium text-indigo-700 ring-1 ring-inset ring-indigo-200">STM32</span>{{ end }}
            </p>
            <p class="mt-4 text-sm"><a class="font-medium text-violet-800" href="/apps/{{.Slug}}">View downloads</a></p>
          </li>
        {{- end }}
      </ul>
    {{ else }}
      <div class="mt-8 rounded-lg border border-dashed border-gray-300 bg-white px-6 py-12 text-center">
        <p class="text-base font-medium text-gray-900">No public apps yet</p>
        <p class="mt-2 text-sm text-gray-600">Create an application in the console and leave it public to list it here.</p>
      </div>
    {{ end }}
  </main>
</div>
{{ end }}
